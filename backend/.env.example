# Copy to .env (git-ignored) for docker compose / local runs. In Azure these values come from App Service settings
# and Key Vault (see docs/azure-deployment.md); infra/scripts/tf.sh reads this file to provision them.

# JWT signing key (HS256, at least 32 characters)
JWT_SECRET=

# Weather database (PostgreSQL)
DATABASE_HOST=weather-postgres
DATABASE_PORT=5432
DATABASE_NAME=weatherdb
# Database credentials
DATABASE_USERNAME=
DATABASE_PASSWORD=

# Redis
REDIS_HOST=redis-cache
REDIS_PORT=6379
REDIS_PASSWORD=

OPEN_WEATHER_API=

# Origin of the frontend (CORS and cookies). Production: https://michael-site.com
WEBSITE_URL=http://localhost:3000

# Optional, production only: real client IP behind Cloudflare and the Next.js proxy
# FORWARD_HEADERS_STRATEGY=native
# CLIENT_IP_HEADER=CF-Connecting-IP
# DATABASE_SSL_MODE=require
