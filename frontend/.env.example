# Copy to .env (git-ignored) for `npm run dev`. NEXT_PUBLIC_* values are inlined into the browser bundle at build time.

# Local development: the browser calls the backend directly (cross-origin, allowed by the backend's WEBSITE_URL).
# Production leaves this empty: the browser calls /api on its own origin and src/proxy.js forwards it to BACKEND_URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Server-only, read at runtime by src/proxy.js (set in App Service). Unset in local development.
# BACKEND_URL=https://<backend-host>
